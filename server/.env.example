# Base de datos del MVP (SQLite, archivo local). Para migrar a Postgres,
# cambia el provider en prisma/schema.prisma y este DATABASE_URL.
DATABASE_URL="file:./dev.db"

# ── Módulo C (monitoreo / scraping) ──
# Fuente de datos: "simulada" (demo offline) | "real" (API oficial Rama Judicial).
FUENTE_JUDICIAL="simulada"

# API oficial CPNU (Consulta de Procesos Nacional Unificada). Verificar/ajustar
# si el portal cambia su estructura (RNF-13).
RAMA_API_BASE="https://consultaprocesos.ramajudicial.gov.co:448/api/v2"

# Frecuencia del monitoreo programado en minutos (RNF-09), para --watch.
INTERVALO_MIN="240"

# Solo fuente simulada: "1" agrega una actuación nueva para demostrar la
# detección por diferencia; "0" devuelve solo lo ya existente.
SIMULAR_NOVEDAD="1"

# ── Módulo D (clasificación con IA · Gemini) ──
# API key de Google AI Studio. NO se versiona: ponla en tu .env local.
GEMINI_API_KEY=""
# Modelo de Gemini. Usa uno que tu key liste (npm run listar:modelos).
# Buenos por costo/velocidad: gemini-2.5-flash · gemini-2.5-flash-lite · gemini-flash-latest.
GEMINI_MODEL="gemini-2.5-flash"
# Modo del clasificador: hibrido (reglas → IA) | reglas | gemini
CLASIFICADOR="hibrido"

# ── Envío de correos (resumen IA al cliente) ──
# Gmail: usa un "App password" (no tu contraseña normal). Sin esto = modo stub.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
